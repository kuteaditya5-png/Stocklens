{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/upstox/readiness",
      "destination": "/api/upstox-readiness"
    },
    {
      "source": "/api/upstox/connect",
      "destination": "/api/upstox-connect"
    },
    {
      "source": "/api/upstox/callback",
      "destination": "/api/upstox-callback"
    },
    {
      "source": "/api/upstox/status",
      "destination": "/api/upstox-status"
    },
    {
      "source": "/api/upstox/disconnect",
      "destination": "/api/upstox-disconnect"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
